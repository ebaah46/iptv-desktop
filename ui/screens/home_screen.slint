import { Theme } from "../theme.slint";
import { TopBar } from "../components/top_bar.slint";
import { Sidebar } from "../components/sidebar.slint";
import { ChannelCard } from "../components/channel_card.slint";
import { Channel } from "../common.slint";
import { HomeState } from "../globals/home_state.slint";
import { CategoryTabs } from "../components/category_tabs.slint";
import { StatusBar } from "../components/status_bar.slint";
import { ScrollView } from "std-widgets.slint";

export component HomeScreen {

    width: 100%;
    height: 100%;

    private property <int> featured_start: max(0, HomeState.channels.length - 10);
    private property <int> featured_count: min(10, HomeState.channels.length);
    private property <int> popular_count: min(10, HomeState.channels.length);
    private property <int> top_category_count: min(10, HomeState.categories.length);
    private property <string> active_category: "All";

    // Layout
    VerticalLayout {
        spacing: 0;

        // Top navigation bar
        TopBar {
            active_tab: "Home";
        }

        // Main content area
        HorizontalLayout {
            spacing: 0;

            // Sidebar
            Sidebar {
                active_category: "All";
            }

            // Main content
            Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.background;

                VerticalLayout {
                    spacing: 0;
                    width: 100%;
                    height: 100%;

                    // Scrollable content area
                    ScrollView {
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            spacing: Theme.spacing_xl;
                            padding: Theme.spacing_xl;

                            // Featured Channels section
                            VerticalLayout {
                                spacing: Theme.spacing_md;

                                Text {
                                    text: "Featured Channels";
                                    color: Theme.text_primary;
                                    font-size: Theme.font_size_xl;
                                    font-weight: 700;
                                }

                                // Row of channel cards - last 10
                                HorizontalLayout {
                                    spacing: Theme.spacing_md;
                                    height: Theme.channel_card_height + 20px;

                                    for i in featured_count : ChannelCard {
                                        channel: HomeState.channels[featured_start + i];
                                        clicked => {
                                            HomeState.channel_selected(HomeState.channels[featured_start + i].name)
                                        }
                                    }
                                }
                            }

                            // Category filter tabs - limited to first 10
                            CategoryTabs {
                                categories: HomeState.categories;
                                top_count: top_category_count;
                                active_category: "All";
                            }

                            // Popular section
                            VerticalLayout {
                                spacing: Theme.spacing_md;

                                Text {
                                    text: "Popular Channels";
                                    color: Theme.text_primary;
                                    font-size: Theme.font_size_xl;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: Theme.spacing_md;
                                    height: Theme.channel_card_height + 20px;

                                    for i in popular_count : ChannelCard {
                                        channel: HomeState.channels[i];
                                        clicked => {
                                            HomeState.channel_selected(HomeState.channels[i].name)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Bottom status bar
        StatusBar {
            has_content: HomeState.channels.length > 0;
            now_playing: "IPTV Desktop";
            app_version: "v0.1.0";
            core_version: "v0.1.0";
            channel_count: HomeState.channels.length;
            stream_quality: "HD";
            connection_status: "Online";
        }
    }
}