import { Theme } from "../theme.slint";
import { TopBar } from "../components/top_bar.slint";
import { Sidebar } from "../components/sidebar.slint";
import { ChannelCard } from "../components/channel_card.slint";
import { ChannelInfo } from "../common.slint";
import { CategoryTabs } from "../components/category_tabs.slint";
import { StatusBar } from "../components/status_bar.slint";
import { ScrollView } from "std-widgets.slint";

export component HomeScreen {
    callback channel_selected(string);

    width: 100%;
    height: 100%;

    // Mock data
    in property <[ChannelInfo]> featured_channels: [
        { id: "espn-hd", name: "ESPN HD", alt_names: [], category_ids: ["sports"], country_code: "US", is_nsfw: false, launched: "1993-09-07", closed: "", website: "https://espn.com", network: "ESPN", logo_text: "E", logo_color: #e63946, current_program: "NFL Football", progress: 0.65 },
        { id: "cnn", name: "CNN", alt_names: [], category_ids: ["news"], country_code: "US", is_nsfw: false, launched: "1980-06-01", closed: "", website: "https://cnn.com", network: "Warner Bros. Discovery", logo_text: "C", logo_color: #457b9d, current_program: "Breaking News", progress: 0.30 },
        { id: "hbo", name: "HBO", alt_names: [], category_ids: ["movies"], country_code: "US", is_nsfw: false, launched: "1972-11-08", closed: "", website: "https://hbo.com", network: "Warner Bros. Discovery", logo_text: "H", logo_color: #6c5ce7, current_program: "The Last of Us", progress: 0.80 },
        { id: "bbc-one", name: "BBC One", alt_names: ["BBC1"], category_ids: ["news"], country_code: "GB", is_nsfw: false, launched: "1936-11-02", closed: "", website: "https://bbc.co.uk", network: "BBC", logo_text: "B", logo_color: #2d6a4f, current_program: "BBC News at Ten", progress: 0.15 },
        { id: "disney-plus", name: "Disney+", alt_names: [], category_ids: ["kids"], country_code: "US", is_nsfw: false, launched: "2019-11-12", closed: "", website: "https://disneyplus.com", network: "Disney", logo_text: "D", logo_color: #f77f00, current_program: "Bluey", progress: 0.50 },
        { id: "nat-geo", name: "National Geographic", alt_names: ["Nat Geo"], category_ids: ["documentaries"], country_code: "US", is_nsfw: false, launched: "1997-09-07", closed: "", website: "https://nationalgeographic.com", network: "National Geographic Society", logo_text: "N", logo_color: #ffd166, current_program: "Planet Earth II", progress: 0.90 },
        { id: "mtv", name: "MTV", alt_names: [], category_ids: ["music"], country_code: "US", is_nsfw: false, launched: "1981-08-01", closed: "", website: "https://mtv.com", network: "Paramount Global", logo_text: "M", logo_color: #e63946, current_program: "Top 40 Countdown", progress: 0.25 },
        { id: "fox-sports", name: "Fox Sports", alt_names: [], category_ids: ["sports"], country_code: "US", is_nsfw: false, launched: "1994-01-01", closed: "", website: "https://foxsports.com", network: "Fox Corporation", logo_text: "F", logo_color: #1a659e, current_program: "UFC Fight Night", progress: 0.45 },
    ];

    in property <[ChannelInfo]> popular_channels: [
        { id: "espn-hd", name: "ESPN HD", alt_names: [], category_ids: ["sports"], country_code: "US", is_nsfw: false, launched: "1993-09-07", closed: "", website: "https://espn.com", network: "ESPN", logo_text: "E", logo_color: #e63946, current_program: "NFL Football", progress: 0.65 },
        { id: "espn-2", name: "ESPN 2", alt_names: [], category_ids: ["sports"], country_code: "US", is_nsfw: false, launched: "1993-10-01", closed: "", website: "https://espn.com", network: "ESPN", logo_text: "2", logo_color: #e63946, current_program: "SportsCenter", progress: 0.20 },
        { id: "cnn", name: "CNN", alt_names: [], category_ids: ["news"], country_code: "US", is_nsfw: false, launched: "1980-06-01", closed: "", website: "https://cnn.com", network: "Warner Bros. Discovery", logo_text: "C", logo_color: #457b9d, current_program: "Breaking News", progress: 0.30 },
        { id: "cnn-intl", name: "CNN International", alt_names: ["CNNi"], category_ids: ["news"], country_code: "US", is_nsfw: false, launched: "1985-09-01", closed: "", website: "https://cnn.com", network: "Warner Bros. Discovery", logo_text: "I", logo_color: #457b9d, current_program: "World News", progress: 0.55 },
        { id: "hbo", name: "HBO", alt_names: [], category_ids: ["movies"], country_code: "US", is_nsfw: false, launched: "1972-11-08", closed: "", website: "https://hbo.com", network: "Warner Bros. Discovery", logo_text: "H", logo_color: #6c5ce7, current_program: "The Last of Us", progress: 0.80 },
        { id: "hbo-2", name: "HBO 2", alt_names: [], category_ids: ["movies"], country_code: "US", is_nsfw: false, launched: "2002-01-01", closed: "", website: "https://hbo.com", network: "Warner Bros. Discovery", logo_text: "2", logo_color: #6c5ce7, current_program: "House of the Dragon", progress: 0.10 },
        { id: "bbc-one", name: "BBC One", alt_names: ["BBC1"], category_ids: ["news"], country_code: "GB", is_nsfw: false, launched: "1936-11-02", closed: "", website: "https://bbc.co.uk", network: "BBC", logo_text: "B", logo_color: #2d6a4f, current_program: "BBC News at Ten", progress: 0.15 },
        { id: "bbc-two", name: "BBC Two", alt_names: ["BBC2"], category_ids: ["documentaries"], country_code: "GB", is_nsfw: false, launched: "1964-04-21", closed: "", website: "https://bbc.co.uk", network: "BBC", logo_text: "2", logo_color: #2d6a4f, current_program: "Horizon", progress: 0.40 },
    ];

    // Layout
    VerticalLayout {
        spacing: 0;

        // Top navigation bar
        TopBar {
            active_tab: "Home";
        }

        // Main content area
        HorizontalLayout {
            spacing: 0;

            // Sidebar
            Sidebar {
                active_category: "All";
            }

            // Main content
            Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.background;

                VerticalLayout {
                    spacing: 0;
                    width: 100%;
                    height: 100%;

                    // Scrollable content area
                    ScrollView {
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            spacing: Theme.spacing_xl;
                            padding: Theme.spacing_xl;

                            // Featured Channels section
                            VerticalLayout {
                                spacing: Theme.spacing_md;

                                Text {
                                    text: "Featured Channels";
                                    color: Theme.text_primary;
                                    font-size: Theme.font_size_xl;
                                    font-weight: 700;
                                }

                                // Row of channel cards
                                HorizontalLayout {
                                    spacing: Theme.spacing_md;
                                    height: Theme.channel_card_height + 20px;

                                    for ch in featured_channels : ChannelCard {
                                        channel: ch;
                                        clicked => {
                                            channel_selected(ch.name);
                                        }
                                    }
                                }
                            }

                            // Category filter tabs
                            CategoryTabs {
                                categories: ["All", "Sports", "News", "Movies", "Documentaries", "Music", "Kids"];
                                active_category: "All";
                            }

                            // Popular section
                            VerticalLayout {
                                spacing: Theme.spacing_md;

                                Text {
                                    text: "Popular Channels";
                                    color: Theme.text_primary;
                                    font-size: Theme.font_size_xl;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: Theme.spacing_md;
                                    height: Theme.channel_card_height + 20px;

                                    for ch in popular_channels : ChannelCard {
                                        channel: ch;
                                        clicked => {
                                            channel_selected(ch.name);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Bottom status bar
        StatusBar {
            has_content: true;
            now_playing: "NFL Football - ESPN HD - Live from MetLife Stadium";
            app_version: "v0.1.0";
            core_version: "v0.1.0";
            channel_count: featured_channels.length;
            stream_quality: "HD";
            connection_status: "Online";
        }
    }
}